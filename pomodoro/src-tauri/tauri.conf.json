{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "番茄钟",
  "version": "1.0.0",
  "identifier": "com.pomodoro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "番茄钟",
        "width": 400,
        "height": 650,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "notification": {
      "all": true
    }
  }
}
